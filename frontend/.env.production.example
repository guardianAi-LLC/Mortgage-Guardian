# ============================================
# REQUIRED — Clerk Authentication
# ============================================
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ============================================
# REQUIRED — API Configuration
# ============================================
# Express backend URL (Railway, Vercel, or custom host)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
# This Vercel deployment URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ============================================
# OPTIONAL — Feature Flags
# ============================================
# Enable Plaid bank account linking (default: false)
NEXT_PUBLIC_ENABLE_PLAID=false
# Enable AI-powered document analysis (default: false)
NEXT_PUBLIC_ENABLE_AI_ANALYSIS=false

# ============================================
# OPTIONAL — Error Tracking
# ============================================
# Sentry DSN for frontend error tracking
# Get from: https://sentry.io → Project Settings → Client Keys
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ============================================
# OPTIONAL — Sentry Source Maps (Vercel only)
# ============================================
# Auth token for uploading source maps to Sentry during Vercel builds
# Get from: https://sentry.io → Settings → Auth Tokens
# When set, source maps are uploaded automatically for better stack traces
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
